# App
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=https://www.creai_it.vercel.app
NEXT_PUBLIC_APPLY_URL=https://www.creai_it.vercel.app

# Database (Neon PostgreSQL - same as Idea Scorer)
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4.1-mini

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=<your-posthog-key>
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Security
PII_ENCRYPTION_KEY=<32-byte-base64-key>
RATE_LIMIT_SECRET=<rate-limit-secret>
AUTH_SECRET=<auth-secret>

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<bcrypt-hash>
